---
// The homepage. A standalone page rather than a Starlight splash: it carries
// its own chart-sheet frame, header, and footer, and links into the docs.
// Console screenshots come from site/screenshots (see its README).
import "../styles/fonts.css";
import tillerLogo from "../../../tiller-logo.svg";
import tillerLogoInverted from "../../../tiller-logo-inverted.svg";
import mitLogo from "../assets/mit-logo-dark-indigo.svg";
import mitLogoWhite from "../assets/mit-logo-website-white.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${base}/${path}`;
const description = "Tiller helps a team of people and coding agents deliver high-quality software fast, with the confidence to ship it. Open source, Apache 2.0.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tiller</title>
<meta name="description" content={description}>
<meta property="og:title" content="Tiller">
<meta property="og:description" content={description}>
<link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
<script is:inline>
  // Follow the theme chosen on the docs pages (Starlight's own key), else the system.
  try {
    var t = localStorage.getItem("starlight-theme");
    if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
<style is:global>
/* Layout: a framed nautical chart. Four value legs run down a scroll-drawn course, each with
   how Tiller delivers it; then an index of everything Tiller does (into the docs) and the install.
   Light is a paper chart; dark is a night chart with the course in lamp ochre. */
:root {
  --paper: #FBFBF5;
  --ink: #001129;
  --ink-2: #3B4759;
  --ink-3: #5F6B7A;
  --frame: #0A2C49;
  --hair: rgba(10, 44, 73, 0.2);
  --hair-2: rgba(10, 44, 73, 0.1);
  --land: #F3ECD6;
  --shoal: #E7EFEE;
  --inset: #F2F4F2;
  --course: #191819;
  --track: rgba(25, 24, 25, 0.42);
  --heed: #9A1659;
  --glow: none;
  --sounding: rgba(10, 44, 73, 0.55);
  --screen: #12151B;
  --term-bg: #0A1626;
  --term-fg: #E8EBF0;
  --term-dim: #93A1B3;
  --term-agent: #96BCBC;
  --term-you: #F49BC0;
  --term-pass: #A6D08F;
  --term-fail: #F59A86;
  --show-light: block;
  --show-dark: none;

  --display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
  --text: "Inter", ui-sans-serif, system-ui, sans-serif;
  --mono: "Space Mono", ui-monospace, Menlo, monospace;

  --lane: 200px;
  --gap: 48px;
  --pad: 40px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #001129; --ink: #ECE8E2; --ink-2: #B3BECA; --ink-3: #8C9AAA; --frame: #96BCBC;
    --hair: rgba(150, 188, 188, 0.22); --hair-2: rgba(150, 188, 188, 0.1); --land: #142630; --shoal: #05203D;
    --inset: #031934; --course: #D3AD44; --track: rgba(211, 173, 68, 0.42); --heed: #EC7CA6;
    --glow: drop-shadow(0 0 5px rgba(236, 124, 166, 0.65)); --sounding: rgba(150, 188, 188, 0.5);
    --screen: #0B0F14; --term-bg: #000814; --show-light: none; --show-dark: block; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #001129; --ink: #ECE8E2; --ink-2: #B3BECA; --ink-3: #8C9AAA; --frame: #96BCBC;
  --hair: rgba(150, 188, 188, 0.22); --hair-2: rgba(150, 188, 188, 0.1); --land: #142630; --shoal: #05203D;
  --inset: #031934; --course: #D3AD44; --track: rgba(211, 173, 68, 0.42); --heed: #EC7CA6;
  --glow: drop-shadow(0 0 5px rgba(236, 124, 166, 0.65)); --sounding: rgba(150, 188, 188, 0.5);
  --screen: #0B0F14; --term-bg: #000814; --show-light: none; --show-dark: block; color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 400 17px/1.62 var(--text);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0;
}
img, video, svg { display: block; max-width: 100%; }
a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; text-decoration-color: var(--hair); }
a:hover { text-decoration-color: currentColor; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
code, pre { font-family: var(--mono); }
p { margin: 0 0 1em; }
.only-light { display: var(--show-light); }
.only-dark { display: var(--show-dark); }

/* The sheet: outer line, graduated border, inner neatline */
.sheet { position: relative; max-width: 1400px; margin: 16px auto; border: 1.5px solid var(--frame); padding: 7px; }
.sheet::before, .sheet::after {
  content: ""; position: absolute; top: 7px; bottom: 7px; width: 7px;
  background: repeating-linear-gradient(to bottom, var(--frame) 0 48px, transparent 48px 96px);
}
.sheet::before { left: 0; }
.sheet::after { right: 0; }
.neat { position: relative; border: 1px solid var(--frame); }
.neat::before, .neat::after {
  content: ""; position: absolute; left: -1px; right: -1px; height: 7px;
  background: repeating-linear-gradient(to right, var(--frame) 0 48px, transparent 48px 96px);
}
.neat::before { top: -8px; }
.neat::after { bottom: -8px; }

/* Header */
.top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px var(--pad); border-bottom: 1px solid var(--hair); position: relative; z-index: 3; }
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font: 600 21px/1 var(--display); letter-spacing: -0.01em; }
.brand img { height: 26px; width: auto; }
.top nav { display: flex; align-items: center; gap: 26px; font-size: 15px; }
.top nav a { text-decoration: none; color: var(--ink-2); }
.top nav a:hover { color: var(--ink); text-decoration: underline; }
.top nav a.install { color: var(--ink); font-weight: 500; border: 1px solid var(--frame); padding: 7px 12px; }

/* Chart body and the course overlay */
.chart { position: relative; padding: 0 var(--pad); overflow: hidden; }
.course { position: absolute; left: 0; top: 0; pointer-events: none; z-index: 0; overflow: visible; }
.course .planned { fill: none; stroke: var(--track); stroke-width: 1.25; stroke-dasharray: 1.5 6; stroke-linecap: round; }
.course .made { fill: none; stroke: var(--course); stroke-width: 1.75; stroke-linejoin: miter; }
.chart > section, .chart > header { position: relative; z-index: 1; }

/* Symbols */
.sym { width: 30px; height: 30px; flex: none; color: var(--ink); overflow: visible; position: relative; z-index: 2; }
symbol .flare { fill: var(--heed); filter: var(--glow); }
symbol .bg { fill: var(--paper); }
symbol .ln { fill: none; stroke: currentColor; stroke-width: 1.5; }
symbol .fl { fill: currentColor; }
.sym.sm { width: 22px; height: 22px; }

/* Hero */
.hero { padding: 76px 0 24px; }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; column-gap: 64px; align-items: start; }
.hero-chart { position: absolute; top: 0; right: calc(-1 * var(--pad)); width: 60%; height: 100%; z-index: -1; pointer-events: none; }
.hero-chart .land { fill: var(--land); }
.hero-chart .coast { fill: none; stroke: var(--frame); stroke-width: 1.1; opacity: 0.8; }
.hero-chart .shoal { fill: var(--shoal); }
.hero-chart .c5 { fill: none; stroke: var(--frame); stroke-width: 0.9; stroke-dasharray: 1 4; stroke-linecap: round; opacity: 0.7; }
.hero-chart .c10 { fill: none; stroke: var(--frame); stroke-width: 0.8; stroke-dasharray: 6 3 1 3; opacity: 0.45; }
.hero-chart text { font: 400 12px var(--display); fill: var(--sounding); }
h1 { font: 500 clamp(42px, 5.6vw, 84px)/1 var(--display); letter-spacing: -0.03em; margin: 0 0 32px; max-width: 12em; text-wrap: balance; }
.lede { font-size: 21px; line-height: 1.5; color: var(--ink-2); max-width: 30em; margin-bottom: 32px; }
.lede strong { color: var(--ink); font-weight: 500; }

.cmd { display: flex; align-items: stretch; max-width: 100%; border: 1px solid var(--frame); background: var(--paper); font: 400 14.5px/1.4 var(--mono); }
.cmd code { padding: 12px 14px; overflow-x: auto; white-space: nowrap; flex: 1 1 auto; min-width: 0; }
.cmd code::before { content: "$ "; color: var(--ink-3); }
.cmd button { flex: none; font: 500 14px/1 var(--text); color: var(--ink); background: transparent; border: 0; border-left: 1px solid var(--frame); padding: 0 16px; cursor: pointer; min-width: 78px; }
.cmd button:hover { background: var(--hair-2); }
.cta { display: flex; flex-wrap: wrap; align-items: stretch; gap: 14px 18px; }
.btn { display: inline-flex; align-items: center; font: 500 15.5px/1 var(--text); text-decoration: none; padding: 13px 18px; border: 1px solid var(--frame); background: var(--frame); color: var(--paper); }
.btn:hover { background: var(--ink); }
.fine { font-size: 14.5px; color: var(--ink-3); margin-top: 16px; }

/* Title block: sailing directions for the page */
.titleblock { background: var(--paper); border: 1px solid var(--frame); outline: 1px solid var(--frame); outline-offset: 4px; padding: 22px 22px 18px; margin-top: 6px; }
.tb-title { font: 500 21px/1.15 var(--display); letter-spacing: -0.01em; margin: 0 0 12px; }
.dirs { list-style: none; margin: 0; padding: 0; }
.dirs li { border-top: 1px solid var(--hair); }
.dirs a { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: center; padding: 10px 0; text-decoration: none; }
.dirs a:hover .d-t { text-decoration: underline; }
.dirs .d-t { font: 500 16px/1.25 var(--display); }
.dirs .d-s { display: block; font: 400 14px/1.35 var(--text); color: var(--ink-2); }
.tb-h { font: 600 13px/1 var(--text); color: var(--ink-2); margin: 10px 0 10px; padding-top: 14px; border-top: 1px solid var(--frame); }
.key { display: grid; grid-template-columns: 22px 1fr; gap: 8px 12px; align-items: center; font-size: 14px; color: var(--ink-2); margin: 0; }
.key dt { margin: 0; }
.key dd { margin: 0; }
.key .line { display: block; width: 22px; border-top: 1.75px solid var(--course); }
.who { font-weight: 700; }
.you .who { color: var(--heed); }

/* Legs: a mark in the lane, the value, how it's delivered, and an inset */
.leg { display: grid; grid-template-columns: var(--lane) minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--gap); align-items: start; padding: 30px 0; }
.leg > .lane { grid-column: 1; grid-row: 1 / span 2; display: flex; align-items: flex-start; gap: 12px; padding-left: var(--dx, 12px); }
.leg > .txt { grid-column: 2; grid-row: 1; min-width: 0; }
.leg > .art { grid-column: 3; grid-row: 1; min-width: 0; }
.leg > .full { grid-column: 2 / span 2; grid-row: 2; margin-top: 32px; min-width: 0; }
.leg.wide > .txt { grid-column: 2 / span 2; max-width: 44em; }
.lbl { font: 500 15px/1.3 var(--display); margin: 5px 0 0; max-width: 150px; }
.lbl .who { font-weight: 700; }
.txt > :last-child { margin-bottom: 0; }
.txt p { max-width: 36em; }
.txt code, .how code, .idx code { font-size: 0.86em; padding: 1px 5px; background: var(--inset); border: 1px solid var(--hair-2); overflow-wrap: anywhere; }

.sec { padding-top: 110px; }
h2 { font: 500 clamp(32px, 4vw, 54px)/1.04 var(--display); letter-spacing: -0.025em; margin: 0 0 20px; max-width: 15em; text-wrap: balance; }
h3 { font: 500 24px/1.2 var(--display); letter-spacing: -0.012em; margin: 0 0 10px; text-wrap: balance; }
.sub { font-size: 19px; color: var(--ink-2); max-width: 34em; }

/* How Tiller delivers it */
.how-h { font: 600 14px/1 var(--text); color: var(--ink-2); margin: 30px 0 4px; }
.how { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--frame); }
.how li { padding: 14px 0; border-bottom: 1px solid var(--hair); }
.how a { font: 500 17px/1.3 var(--display); text-decoration-color: var(--hair); }
.how p { margin: 4px 0 0; font-size: 15.5px; color: var(--ink-2); line-height: 1.5; }

/* Insets */
.inset { border: 1px solid var(--frame); background: var(--paper); margin: 0; }
.inset-t { display: inline-block; font: 500 13px/1.3 var(--display); padding: 7px 12px; border-right: 1px solid var(--frame); border-bottom: 1px solid var(--frame); }
.inset img { width: 100%; height: auto; margin-top: -1px; border-top: 1px solid var(--hair); }
.inset pre { margin: -1px 0 0; padding: 16px 18px 18px; font-size: 13px; line-height: 1.65; overflow-x: auto; background: var(--inset); border-top: 1px solid var(--hair); }
.inset pre i { font-style: normal; color: var(--ink-3); }
.inset pre b { font-weight: 700; }
.inset pre .h { color: var(--heed); font-weight: 700; }
.inset figcaption { font-size: 14px; color: var(--ink-2); padding: 12px 14px; border-top: 1px solid var(--hair); }

.shots { display: grid; gap: 28px; }
.crew { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 20px 0 0; padding: 0; }
.crew li { font: 500 15px/1 var(--display); border: 1px solid var(--frame); padding: 9px 14px; }

/* Passage plan: the lifecycle, horizontal */
.passage { list-style: none; margin: 0; padding: 22px 0 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); position: relative; border-top: 1px solid var(--frame); }
.passage::before { content: ""; position: absolute; left: 4%; right: 4%; top: 37px; border-top: 1px dotted var(--track); }
.passage li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; font: 400 15px/1.25 var(--display); padding: 0 6px; position: relative; }

/* The faux terminal: one feature from plan to merge, played step by step */
.passage button { appearance: none; background: none; border: 0; padding: 0; margin: 0; font: inherit; color: var(--ink-2); cursor: pointer; display: flex; flex-direction: inherit; align-items: center; gap: 10px; text-align: inherit; }
.passage button:hover .st { text-decoration: underline; text-underline-offset: 3px; }
.passage button[aria-current="step"] { color: var(--ink); }
.passage button[aria-current="step"] .st { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--course); }
.passage button.past { color: var(--ink); }
.player { margin-top: 36px; }
.term {
  background: var(--term-bg); color: var(--term-fg);
  font: 400 13.5px/1.62 var(--mono);
  height: 460px; overflow-y: auto; overscroll-behavior: contain;
  padding: 16px 20px 22px; margin-top: -1px; border-top: 1px solid var(--hair);
  scrollbar-color: var(--term-dim) transparent;
}
.term .ln { white-space: pre-wrap; overflow-wrap: anywhere; padding-left: 8ch; text-indent: -8ch; min-height: 1.62em; }
.term .who { display: inline-block; width: 8ch; text-indent: 0; font-weight: 700; }
.term .agent .who, .term .agent.say .who { color: var(--term-agent); }
.term .you .who, .term .you.say .who { color: var(--term-you); }
.term .pr { color: var(--term-dim); }
.term .out { color: var(--term-dim); }
.term .out b { color: var(--term-fg); font-weight: 700; }
.term .out .bad { color: var(--term-fail); font-weight: 700; }
.term .out .good { color: var(--term-pass); font-weight: 700; }
.term .say .msg { color: var(--term-fg); }
.term .gap { min-height: 0.8em; }
.term .stage-h { color: var(--term-dim); padding-left: 0; text-indent: 0; margin: 4px 0 2px; }
.term .caret { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; background: var(--term-fg); animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }
.chapters { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); border-top: 1px solid var(--hair); }
.chapters li + li { border-left: 1px solid var(--hair-2); }
.chapters button { appearance: none; width: 100%; height: 100%; background: none; border: 0; border-top: 2px solid transparent; margin-top: -1px; padding: 9px 4px 11px; font: 500 13.5px/1.25 var(--text); color: var(--ink-3); cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
.chapters .n { font: 400 11.5px/1 var(--mono); }
.chapters .you .n { color: var(--heed); }
.chapters .g { display: inline-flex; align-items: center; gap: 5px; }
.chapters svg { width: 13px; height: 13px; flex: none; }
.chapters button:hover { color: var(--ink); }
.chapters button.past { color: var(--ink-2); }
.chapters button[aria-current="step"] { color: var(--ink); font-weight: 600; border-top-color: var(--course); }
.term-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 10px 14px; border-top: 1px solid var(--hair); }
.term-bar button { font: 500 14px/1 var(--text); color: var(--ink); background: transparent; border: 1px solid var(--frame); padding: 8px 14px; cursor: pointer; }
.term-bar button:hover { background: var(--hair-2); }
.term-now { margin: 0 0 0 auto; font: 500 14px/1.3 var(--display); color: var(--ink-2); }
.term-now .who { color: var(--ink); }
.term-now.you .who { color: var(--heed); }
.inset-note { font-size: 14px; color: var(--ink-2); padding: 12px 14px; margin: 0; border-top: 1px solid var(--hair); }

/* Index of sheets: everything Tiller does, into the docs */
.idx-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 48px; border-top: 2px solid var(--frame); border-bottom: 2px solid var(--frame); }
.idx { list-style: none; margin: 0; padding: 0; min-width: 0; }
.idx li { border-bottom: 1px solid var(--hair); }
.idx li:last-child { border-bottom: 0; }
.idx a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 16px 0; text-decoration: none; }
.idx .t { font: 500 18px/1.3 var(--display); }
.idx a:hover .t { text-decoration: underline; text-underline-offset: 3px; }
.idx .s { font-size: 15px; line-height: 1.5; color: var(--ink-2); }
.idx-foot { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; margin-top: 26px; }
.idx-foot a.text { font-weight: 500; }
.map-inset { margin-top: 40px; }

/* Fit: good water and shoal water */
.fit { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--frame); border-bottom: 1px solid var(--frame); }
.fit > div { padding: 28px 32px 30px 0; }
.fit > div + div { padding-left: 32px; border-left: 1px solid var(--hair); }
.buoy-row { display: flex; align-items: flex-end; gap: 14px; margin-bottom: 14px; }
.buoy { width: 36px; height: 60px; color: var(--ink); flex: none; }
.buoy .ln { fill: none; stroke: currentColor; stroke-width: 1.4; }
.buoy .fl { fill: currentColor; }
.buoy .bg { fill: var(--paper); }
.fit h3 { margin: 0; }
.fit ul { margin: 0; padding: 0 0 0 1.1em; }
.fit li { margin: 0 0 6px; }

/* Install */
.one { font: 500 clamp(30px, 3.6vw, 48px)/1.06 var(--display); letter-spacing: -0.02em; margin: 0 0 10px; }
.scale { margin: 18px 0 34px; max-width: 520px; }
.scale-bar { display: grid; grid-template-columns: repeat(3, 1fr); height: 10px; border: 1px solid var(--frame); }
.scale-bar span:nth-child(odd) { background: var(--frame); }
.scale-ticks { display: grid; grid-template-columns: repeat(3, 1fr); font: 500 14px/1.3 var(--display); margin-top: 8px; }
.installs { display: grid; gap: 18px; max-width: 760px; }
.installs > div { min-width: 0; }
.installs h3 { font: 600 14px/1.3 var(--text); color: var(--ink-2); margin: 0 0 8px; }
.kinds { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 40px 0 0; border-top: 1px solid var(--frame); }
.kinds > div { padding: 18px 24px 0 0; min-width: 0; }
.kinds > div + div { padding-left: 24px; border-left: 1px solid var(--hair); }
.kinds code { font: 700 14px/1.4 var(--mono); display: block; margin-bottom: 6px; overflow-wrap: anywhere; }
.kinds p { margin: 0; font-size: 15.5px; color: var(--ink-2); }
.next { display: flex; flex-wrap: wrap; gap: 14px 18px; align-items: center; margin-top: 32px; }

/* Close */
.close { padding: 190px 0 90px; text-align: center; }
.close .sym { width: 76px; height: 76px; margin: 0 auto; }
.close .lbl { max-width: none; margin: 12px auto 0; font-size: 17px; }
.close blockquote { margin: 56px auto 0; max-width: 17em; font: 500 clamp(34px, 5vw, 68px)/1.04 var(--display); letter-spacing: -0.03em; text-wrap: balance; }

.imprint { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; padding: 22px var(--pad); border-top: 1px solid var(--hair); font-size: 14.5px; color: var(--ink-2); position: relative; z-index: 3; }
.imprint .mit { display: flex; align-items: center; gap: 14px; }
.imprint .mit img { height: 22px; width: auto; }
.imprint nav { display: flex; flex-wrap: wrap; gap: 8px 22px; }
.imprint a { text-decoration: none; }
.imprint a:hover { text-decoration: underline; }
.imprint a.mit-link { text-decoration: underline; text-decoration-color: var(--hair); color: var(--ink); }
.imprint a.mit-link:hover { text-decoration-color: currentColor; }

@media (max-width: 1180px) {
  :root { --lane: 160px; --gap: 32px; --pad: 32px; }
  .lbl { max-width: 120px; }
  .hero-grid { grid-template-columns: minmax(0, 1fr) 330px; column-gap: 40px; }
  .leg { grid-template-columns: var(--lane) minmax(0, 1fr); }
  .leg > .art { grid-column: 2; grid-row: 2; margin-top: 28px; }
  .leg > .full { grid-column: 2; grid-row: 3; }
  .leg.wide > .txt { grid-column: 2; }
  .leg.wide > .full { grid-row: 2; }
  .passage { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 22px; }
