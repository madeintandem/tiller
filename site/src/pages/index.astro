</div></div>

<script is:inline>
(function () {
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Copy buttons
  document.querySelectorAll("[data-copy]").forEach(function (b) {
    b.addEventListener("click", function () {
      var el = document.getElementById(b.dataset.copy);
      var done = function () { b.textContent = "Copied"; setTimeout(function () { b.textContent = "Copy"; }, 1600); };
      var pick = function () { var r = document.createRange(); r.selectNodeContents(el); var s = getSelection(); s.removeAllRanges(); s.addRange(r); };
      try { navigator.clipboard.writeText(el.textContent).then(done, pick); } catch (e) { pick(); }
    });
  });

  // The course: a planned track through every waypoint, drawn solid as you read
  var chart = document.getElementById("chart"), svg = document.getElementById("course");
  var planned = document.getElementById("planned"), made = document.getElementById("made");
  var len = 0;
  function draw() {
    var r = chart.getBoundingClientRect();
    var pts = Array.prototype.filter.call(chart.querySelectorAll(".wp"), function (e) { return e.getClientRects().length; })
      .map(function (e) { var b = e.getBoundingClientRect(); return [Math.round(b.left - r.left + b.width / 2), Math.round(b.top - r.top + b.height / 2)]; });
    if (pts.length < 2) return;
    svg.setAttribute("width", r.width); svg.setAttribute("height", r.height);
    svg.setAttribute("viewBox", "0 0 " + r.width + " " + r.height);
    var d = "M" + pts.map(function (p) { return p.join(" "); }).join(" L");
    planned.setAttribute("d", d); made.setAttribute("d", d);
    len = made.getTotalLength();
    made.style.strokeDasharray = len + " " + len;
    progress();
  }
  function progress() {
    if (!len) return;
    if (reduce) { made.style.strokeDashoffset = 0; return; }
    var target = innerHeight * 0.62 - chart.getBoundingClientRect().top;
    var lo = 0, hi = len;
    for (var i = 0; i < 22; i++) { var mid = (lo + hi) / 2; if (made.getPointAtLength(mid).y < target) lo = mid; else hi = mid; }
    made.style.strokeDashoffset = len - lo;
  }
  var raf = 0;
  addEventListener("scroll", function () { if (!raf) raf = requestAnimationFrame(function () { raf = 0; progress(); }); }, { passive: true });
  addEventListener("resize", draw);
  addEventListener("load", draw);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
  draw();

  // The faux terminal: one feature from plan to merge. Commands and output are
  // Tiller's own (captured from a real run, trimmed); notes summarize the agent.
  var T = "event-night/door-check-in/attendee-search";
  var STAGES = ["Agent: Decompose", "You: Approve the shape", "Agent: Specify", "You: Approve the plan", "Agent: Build and pass checks", "Agent + you: Review", "You: Merge"];
  var steps = [
    { s: 0, a: "agent", say: "Reading the design docs and proposing the work." },
    { s: 0, a: "agent", cmd: 'tiller add epic event-night --title "Event night"', out: ["Created epic event-night (E-pm0kyk) in **draft**."] },
    { s: 0, a: "agent", cmd: 'tiller add feature event-night/door-check-in --title "Door check-in"', out: ["Created feature event-night/door-check-in (F-jn1wyk) in **draft**."] },
    { s: 0, a: "agent", cmd: 'tiller add feature event-night/attendance --title "Attendance" --depends-on event-night/door-check-in', out: ["Created feature event-night/attendance (F-bz7hud) in **draft**; depends on event-night/door-check-in (F-jn1wyk)."] },
    { s: 0, a: "agent", say: "One epic, two features. Over to you to approve the shape." },
    { s: 1, a: "you", cmd: "tiller approve epic event-night", out: ["epic event-night (E-pm0kyk) is now **ready**.", "", "**Next:**", "1. Agent: specify event-night/door-check-in (F-jn1wyk). `tiller guide specify`"] },
    { s: 2, a: "agent", say: "Writing the spec and its acceptance criteria for door check-in." },
    { s: 2, a: "agent", cmd: 'tiller add task ' + T + ' --title "Attendee search"', out: ["Created task " + T + " (T-9fbdmz) in **proposed**: \"Attendee search\""] },
    { s: 2, a: "agent", cmd: 'tiller add task event-night/door-check-in/check-in-button --title "Check-in button" --depends-on ' + T, out: ["Created task event-night/door-check-in/check-in-button (T-54t6jh) in **proposed**: \"Check-in button\"; depends on " + T + " (T-9fbdmz)."] },
    { s: 2, a: "agent", cmd: "tiller spec feature event-night/door-check-in", out: ["feature event-night/door-check-in (F-jn1wyk) is now **specced**."] },
    { s: 2, a: "agent", say: "Spec, acceptance criteria, and two tasks are written. Ready for your review." },
    { s: 3, a: "you", cmd: "tiller approve feature event-night/door-check-in", out: ["feature event-night/door-check-in (F-jn1wyk) is now **ready**. 2 task(s) in the plan moved to ready with it.", "", "**Next:**", "1. Agent: claim and start " + T + " (T-9fbdmz). `tiller claim task " + T + "`"] },
    { s: 4, a: "agent", cmd: "tiller claim task " + T, out: ["Claimed " + T + " (T-9fbdmz) for robin."] },
    { s: 4, a: "agent", cmd: "tiller start task " + T, out: ["task " + T + " (T-9fbdmz) is now **in_progress**. Work happens on branch tiller/" + T + "."] },
    { s: 4, a: "agent", say: "Writing the tests first." },
    { s: 4, a: "agent", cmd: "tiller check task " + T, out: ["gate tests: running (bin/test)...", "gate tests: !!fail!! (0s)", "!!Blocked:!! task " + T + " (T-9fbdmz) has unsatisfied required gate(s): tests."] },
    { s: 4, a: "agent", say: "Red, as it should be. Now the implementation." },
    { s: 4, a: "agent", cmd: "tiller check task " + T, out: ["gate tests: running (bin/test)...", "gate tests: ++pass++ (0s)", "Checked task " + T + " (T-9fbdmz): all required gates ++green++; state is now **check**."] },
    { s: 5, a: "agent", cmd: "gh pr create --fill", out: ["https://github.com/acme/checkin/pull/42"] },
    { s: 5, a: "agent", cmd: "tiller submit task " + T + " --pr 42", out: ["task " + T + " (T-9fbdmz) is now **in_review**.", "", "**Up next:**", "1. You: merge " + T + " (T-9fbdmz). Waiting on your merge."] },
    { s: 5, a: "you", say: "Reading the diff on pull request 42. It does what the spec says." },
    { s: 6, a: "you", cmd: "gh pr merge 42 --merge", out: ["++✓++ Merged pull request #42 (Attendee search)"] },
    { s: 6, a: "you", cmd: "tiller sync", out: ["Sync: recorded 1 done crossing(s):", "  - task " + T + " (T-9fbdmz) -> **done**", "", "**Next:**", "1. Agent: claim and start event-night/door-check-in/check-in-button (T-54t6jh)."] }
  ];

  var term = document.getElementById("term"), nowEl = document.getElementById("termNow");
  var playBtn = document.getElementById("termPlay"), replayBtn = document.getElementById("termReplay");
  var stageBtns = Array.prototype.slice.call(document.querySelectorAll("#passage button"));
  // The moments rail under the terminal: each starts at a step in the session.
  var CHAPTERS = [
    { at: 0, a: "agent", t: "Propose" }, { at: 5, a: "you", t: "Approve" }, { at: 6, a: "agent", t: "Specify" },
    { at: 11, a: "you", t: "Approve" }, { at: 12, a: "agent", t: "Start" }, { at: 15, a: "agent", t: "Red", g: "red" },
    { at: 17, a: "agent", t: "Green", g: "green" }, { at: 18, a: "agent", t: "Submit" }, { at: 20, a: "you", t: "Review" },
    { at: 21, a: "you", t: "Merge" }, { at: 22, a: "agent", t: "Done", g: "green" }
  ];
  var GLYPH = {
    red: '<svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3.8 7 H10.2" stroke="currentColor" stroke-width="2"/></svg>',
    green: '<svg viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 7.2 L6.2 9.4 L10.2 4.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>'
  };
  var chapList = document.getElementById("chapters");
  var chapBtns = CHAPTERS.map(function (c, k) {
    var li = document.createElement("li"), b = document.createElement("button");
    if (c.a === "you") li.className = "you";
    b.type = "button";
    b.innerHTML = '<span class="n">' + c.a + '</span><span class="g">' + (c.g ? GLYPH[c.g] : "") + c.t + "</span>";
    b.setAttribute("aria-label", "Jump to " + c.t + " (" + c.a + ")");
    b.addEventListener("click", function () {
      if (reduce) {
        var end = k + 1 < CHAPTERS.length ? CHAPTERS[k + 1].at : steps.length;
        runId++; playing = false; playBtn.textContent = "Play"; started = true;
        rebuild(end); pos = end; playBtn.hidden = pos >= steps.length;
        return;
      }
      from(c.at);
    });
    li.appendChild(b); chapList.appendChild(li);
    return b;
  });
  function markChapter(idx) {
    var cur = -1;
    CHAPTERS.forEach(function (c, k) { if (idx >= c.at) cur = k; });
    chapBtns.forEach(function (b, k) {
      if (k === cur) b.setAttribute("aria-current", "step"); else b.removeAttribute("aria-current");
      b.classList.toggle("past", k < cur);
    });
  }
  var esc = function (t) { return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); };
  var fmt = function (t) {
    return esc(t)
      .replace(/\*\*(.+?)\*\*/g, "<b>$1</b>")
      .replace(/!!(.+?)!!/g, '<span class="bad">$1</span>')
      .replace(/\+\+(.+?)\+\+/g, '<span class="good">$1</span>');
  };
  var whoLabel = function (a) { return a === "you" ? "you" : "agent"; };

  var pos = 0, playing = false, runId = 0, started = false, shownStage = -1;
  var sleep = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };

  function line(cls, html) {
    var d = document.createElement("div");
    d.className = "ln " + cls;
    d.innerHTML = html;
    term.appendChild(d);
    term.scrollTop = term.scrollHeight;
    return d;
  }
  function stageHeader(i) {
    if (i === shownStage) return;
    shownStage = i;
    if (term.childElementCount) line("gap", "");
    line("stage-h", "# " + esc(STAGES[i]));
  }
  function markStage(i) {
    stageBtns.forEach(function (b, k) {
      if (k === i) b.setAttribute("aria-current", "step"); else b.removeAttribute("aria-current");
      b.classList.toggle("past", k < i);
    });
    var who = STAGES[i].split(":")[0];
    nowEl.className = "term-now" + (who === "You" ? " you" : "");
    nowEl.innerHTML = 'Step ' + (i + 1) + ' of 7: <span class="who">' + esc(who) + ":</span>" + esc(STAGES[i].slice(who.length + 1));
  }
  function renderStep(st) {
    stageHeader(st.s);
    if (st.say) { line(st.a + " say", '<span class="who">' + whoLabel(st.a) + '</span><span class="msg">' + esc(st.say) + "</span>"); return; }
    line(st.a + " tc", '<span class="who">' + whoLabel(st.a) + '</span><span class="pr">$ </span>' + esc(st.cmd));
    st.out.forEach(function (o) { line("out", o ? fmt(o) : ""); });
  }
  function rebuild(n) {
    term.innerHTML = ""; shownStage = -1;
    for (var i = 0; i < n; i++) renderStep(steps[i]);
    if (n > 0) { markStage(steps[Math.min(n, steps.length) - 1].s); markChapter(n - 1); }
  }
  async function animateStep(st, id, idx) {
    stageHeader(st.s);
    markStage(st.s);
    markChapter(idx);
    await sleep(st.a === "you" ? 900 : 450);
    if (id !== runId) return false;
    if (st.say) {
      var d = line(st.a + " say", '<span class="who">' + whoLabel(st.a) + '</span><span class="msg"></span>');
      var m = d.querySelector(".msg");
      for (var k = 1; k <= st.say.length; k += 2) { if (id !== runId) return false; m.textContent = st.say.slice(0, k); await sleep(16); }
      m.textContent = st.say;
      await sleep(500);
      return id === runId;
    }
    var c = line(st.a + " tc", '<span class="who">' + whoLabel(st.a) + '</span><span class="pr">$ </span><span class="typed"></span><span class="caret"></span>');
    var typed = c.querySelector(".typed"), caret = c.querySelector(".caret");
    for (var j = 1; j <= st.cmd.length; j++) { if (id !== runId) return false; typed.textContent = st.cmd.slice(0, j); await sleep(st.cmd.length > 70 ? 9 : 18); }
    caret.remove();
    await sleep(320);
    for (var o = 0; o < st.out.length; o++) {
      if (id !== runId) return false;
      line("out", st.out[o] ? fmt(st.out[o]) : "");
      await sleep(st.out[o].indexOf("running") >= 0 ? 700 : 90);
    }
    await sleep(500);
    return id === runId;
  }
  async function run() {
    var id = ++runId;
    playing = true; playBtn.textContent = "Pause";
    while (pos < steps.length) {
      var ok = await animateStep(steps[pos], id, pos);
      if (!ok) return;
      pos++;
    }
    playing = false; playBtn.textContent = "Play";
    playBtn.hidden = true;
  }
  function pause() {
    runId++; playing = false; playBtn.textContent = "Play";
    rebuild(Math.min(pos + 1, steps.length)); pos = Math.min(pos + 1, steps.length);
    if (pos >= steps.length) playBtn.hidden = true;
  }
  function from(i) {
    runId++; pos = i; playBtn.hidden = false; started = true;
    rebuild(i);
    run();
  }
  playBtn.addEventListener("click", function () {
    if (playing) { pause(); return; }
    if (!started) { started = true; from(0); return; }
    run();
  });
  replayBtn.addEventListener("click", function () { from(0); });
  stageBtns.forEach(function (b) {
    b.addEventListener("click", function () {
      var s = Number(b.dataset.stage), i = 0;
      while (steps[i].s !== s) i++;
      if (reduce) {
        runId++; playing = false; playBtn.textContent = "Play"; playBtn.hidden = false; started = true;
        var end = i; while (end < steps.length && steps[end].s === s) end++;
        rebuild(end); pos = end; markStage(s);
        if (pos >= steps.length) playBtn.hidden = true;
        return;
      }
      from(i);
    });
  });

  // At rest the whole session is printed, so it reads without motion. It plays
  // once, from the top, the first time it scrolls into view.
  rebuild(steps.length); pos = steps.length;
  nowEl.textContent = "Seven steps, one feature. Press Play to watch it run.";
  stageBtns.concat(chapBtns).forEach(function (b) { b.removeAttribute("aria-current"); b.classList.remove("past"); });
  playBtn.hidden = false;
  if (!reduce && "IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (es) {
      if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); if (!started) { started = true; from(0); } }
    }, { threshold: 0.45 });
    io.observe(term);
  }
})();
</script>
</body>
</html>
